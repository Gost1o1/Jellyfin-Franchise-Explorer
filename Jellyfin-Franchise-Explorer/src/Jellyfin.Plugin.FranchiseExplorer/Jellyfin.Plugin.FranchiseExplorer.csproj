<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.FranchiseExplorer</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.FranchiseExplorer</AssemblyName>
    <Version>0.8.9.5</Version>
    <AssemblyVersion>0.8.9.5</AssemblyVersion>
    <FileVersion>0.8.9.5</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Jellyfin provides these assemblies. Never ship framework DLLs in the plugin ZIP. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.2.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Configuration/configPage.html" />
    <EmbeddedResource Include="Configuration/configPage.html" />
    <EmbeddedResource Include="Configuration/browsePage.html" />
    <EmbeddedResource Include="Web/franchise-my-media.js" />
    <EmbeddedResource Include="Web/franchise-timeline.js" />
  </ItemGroup>
</Project>
